% notation of the paper
\newcommand{\pkq}[1]{„#1”}                       % a quoted sentence: outside PK
\newcommand{\sem}[1]{[\![#1]\!]}                 % the set of readings
\newcommand{\PKz}{PK$_0$}
\newcommand{\PKzj}[1]{PK$_0^{#1}$}               % the fragment with at most #1 negations
\makeatletter
\newcommand{\wiersze}[1]{\@@input #1 }           % generated rows of a table; expandable, so \bottomrule may follow
\makeatother
\newcommand{\rysunek}[3]{%                       % file, caption, label
  \begin{figure}[tp]
  \centering
  \includegraphics[width=\textwidth]{figures/#1.pdf}
  \caption{#2}
  \label{#3}
  \end{figure}}
